# Optional: set the site's real origin before publishing for absolute social URLs.
# SITE_URL=https://your-domain.example

# Run npm run admin:setup to generate local owner credentials and a session secret.
# ADMIN_USERNAME=owner
# ADMIN_PASSWORD_HASH=<salt:64-byte-scrypt-hash>
# ADMIN_SESSION_SECRET=<at-least-32-random-characters>
# ADMIN_DATA_PATH=/absolute/path/to/private/admin.json
